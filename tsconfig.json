{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["contracts/**/*.ts", "tools/**/*.ts", "sensors/**/*.ts", "scoring/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
