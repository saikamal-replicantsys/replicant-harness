{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replisense.example/contracts/run-trace.schema.json",
  "title": "Harness Run Trace",
  "type": "object",
  "required": ["runId", "workflow", "workflowVersion", "startedAt", "completedAt", "provider", "model", "providerRoutingReason", "guideVersions", "contractVersions", "evidenceIds", "attempts", "finalDecision"],
  "additionalProperties": false,
  "properties": {
    "runId": { "type": "string" },
    "workflow": { "type": "string" },
    "workflowVersion": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "providerRoutingReason": { "type": "string" },
    "guideVersions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "contractVersions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attempt", "provider", "status", "latencyMs", "estimatedTokens", "estimatedCostBand", "sensorResults", "triggeredAction"],
        "additionalProperties": false,
        "properties": {
          "attempt": { "type": "integer", "minimum": 1 },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "status": { "type": "string" },
          "latencyMs": { "type": "integer", "minimum": 0 },
          "estimatedTokens": {
            "type": "object",
            "required": ["input", "output"],
            "additionalProperties": false,
            "properties": {
              "input": { "type": "integer", "minimum": 0 },
              "output": { "type": "integer", "minimum": 0 }
            }
          },
          "estimatedCostBand": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "sensorResults": {
            "type": "array",
            "items": {
              "$ref": "sensor-result.schema.json"
            }
          },
          "triggeredAction": {
            "type": "string",
            "enum": ["ACCEPT", "REPAIR", "RETRY", "REGENERATE_WITH_EVIDENCE", "FALLBACK_PROVIDER", "HUMAN_REVIEW", "BLOCK", "REJECT"]
          }
        }
      }
    },
    "finalDecision": {
      "type": "string",
      "enum": ["ACCEPT", "REPAIR", "RETRY", "REGENERATE_WITH_EVIDENCE", "FALLBACK_PROVIDER", "HUMAN_REVIEW", "BLOCK", "REJECT"]
    }
  }
}
