{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replisense.example/contracts/writer-response.schema.json",
  "title": "Writer Section Generation Response",
  "type": "object",
  "required": ["sectionId", "blocks"],
  "additionalProperties": false,
  "properties": {
    "sectionId": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/headingBlock" },
          { "$ref": "#/$defs/paragraphBlock" },
          { "$ref": "#/$defs/bulletListBlock" },
          { "$ref": "#/$defs/numberedListBlock" },
          { "$ref": "#/$defs/tableBlock" }
        ]
      }
    }
  },
  "$defs": {
    "chunkIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "headingBlock": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 2, "maximum": 4 },
        "text": { "type": "string", "minLength": 1 },
        "chunkIds": { "$ref": "#/$defs/chunkIds" }
      }
    },
    "paragraphBlock": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "type": "string", "minLength": 1 },
        "chunkIds": { "$ref": "#/$defs/chunkIds" }
      }
    },
    "bulletListBlock": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "bullet_list" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "chunkIds": { "$ref": "#/$defs/chunkIds" }
            }
          }
        }
      }
    },
    "numberedListBlock": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "numbered_list" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "chunkIds": { "$ref": "#/$defs/chunkIds" }
            }
          }
        }
      }
    },
    "tableBlock": {
      "type": "object",
      "required": ["type", "columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "table" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "chunkIds": { "$ref": "#/$defs/chunkIds" }
      }
    }
  }
}
