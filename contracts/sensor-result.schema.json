{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replisense.example/contracts/sensor-result.schema.json",
  "title": "Sensor Result",
  "type": "object",
  "required": ["sensor", "status", "severity", "violations", "metadata"],
  "additionalProperties": false,
  "properties": {
    "sensor": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "warning", "skipped"]
    },
    "severity": {
      "type": "string",
      "enum": ["blocking", "advisory"]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
